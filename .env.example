# Copia este archivo como .env y cambia los valores. No subas .env a ningún repositorio.

# --- MySQL (Docker) ---
MYSQL_ROOT_PASSWORD=root
DB_NAME=iot_frontend
DB_USER=iot_front
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3307

# --- Flask ---
# Firma las cookies de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Comunicación cifrada con el backend (misma llave en ambos lados) ---
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLAVE_SECRETA=

CORREO_REMITENTE=
CORREO_CLAVE_APP=
