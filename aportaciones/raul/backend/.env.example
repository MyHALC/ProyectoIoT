# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Llave maestra del servidor (64 caracteres hexadecimales = 256 bits)
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
LLAVE_MAESTRA_SERVIDOR=change_me_64_hex_chars

# Orígenes CORS autorizados para las aplicaciones frontend
ORIGEN_CORS_APP_USERS=http://127.0.0.1:5000
ORIGEN_CORS_APP_ADMIN=http://127.0.0.1:5001
